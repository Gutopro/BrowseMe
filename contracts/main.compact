pragma language_version >= 0.22;

import CompactStandardLibrary;

// ============================================================
// BrowseMe — core contract (v0.3 — details sharing)
// Implements: §8.1 ledger state, §8.2 structs, §8.3 circuit
// boundaries, and the security notes in §9.
//
// CHANGES FROM v0.2:
// - Handshakes now carry an encryption public key for each party
//   (investorKey set at initiateHandshake, ownerKey set at shake).
// - After a handshake is SEALED, each party can deliver their private
//   details to the other as an encrypted package stored on-chain
//   (deliverInvestorDetails / deliverBusinessDetails). The contract
//   never sees plaintext: packages are opaque bytes encrypted in the
//   client to the counterparty's public key.
// - Package contents include the commitment randomness, so the receiver
//   can recompute the commitment (businessCommitmentOf /
//   investorCommitmentOf, exported pure circuits) and compare it with
//   the one registered on-chain.
// - unshake removes both packages from current ledger state.
// - investorDataStaged removed: nothing was ever staged, so the flag
//   only misled readers.
// - BusinessForm.description widened to Bytes<128> and contactInfo to
//   Bytes<64> so the details shared after a handshake are usable.
// ============================================================

// ---- Enums ----

export enum Track { TRACK_A, TRACK_B }
export enum Status { INVESTING, OPEN }
export enum AttesterType { COMMUNITY, RELIGIOUS, UNION, EDUCATION }

// ---- Structs (§8.2) ----

struct BusinessListing {
  track: Track,
  tier: Uint<8>,          // 0 = pending/unlisted, 1 = T1 (highest) .. 3 = T3
  status: Status,
  sector: Bytes<32>,      // coarse — promoted field, §6
  location: Bytes<32>,    // coarse — promoted field, §6
  commitment: Bytes<32>,  // commitment to full private BusinessForm
  listed: Boolean         // true once publicly discoverable (§4.2)
}

struct HandshakeState {
  investorId: Bytes<32>,
  businessId: Uint<64>,
  shaken: Boolean,
  unshaken: Boolean,
  investorKey: Bytes<32>, // investor's encryption public key, set at initiate
  ownerKey: Bytes<32>     // owner's encryption public key, set at shake (zeros until then)
}

// Everything a business would rather not put on-chain in the clear.
// Exported because the exported pure circuit below takes it as a parameter.
export struct BusinessForm {
  name: Bytes<32>,
  description: Bytes<128>,
  contactInfo: Bytes<64>,
  sector: Bytes<32>,
  location: Bytes<32>
}

export struct InvestorForm {
  name: Bytes<32>,
  region: Bytes<32>,
  businessId: Bytes<32>,
  taxId: Bytes<32>
}

// PLACEHOLDER — the real identity an attester is vouching with.
struct AttesterIdentity {
  identitySecret: Bytes<32>
}

// ---- Witnesses ----

witness callerAddress(): Bytes<32>;               // caller's wallet-derived address, supplied by the DApp
witness businessFormData(): BusinessForm;         // private business form, supplied by the DApp
witness businessFormRand(): Bytes<32>;            // fresh randomness for the business commitment (saved client-side)
witness investorFormData(): InvestorForm;         // private investor form, supplied by the DApp
witness investorFormRand(): Bytes<32>;            // fresh randomness for the investor commitment (saved client-side)
witness attesterIdentityData(): AttesterIdentity; // private attester identity, supplied by the DApp

// ---- Public ledger state (§8.1) ----

export ledger businesses: Map<Uint<64>, BusinessListing>;
export ledger nextBusinessId: Uint<64>;
export ledger businessOwners: Map<Uint<64>, Bytes<32>>;      // businessId -> registering caller's address
export ledger investors: Map<Bytes<32>, Bytes<32>>;          // investorId (caller address) -> commitment
export ledger attestationCounts: Map<Uint<64>, Uint<8>>;
export ledger hasUnionAttestation: Map<Uint<64>, Boolean>;   // enforces §9.3 union requirement
export ledger attestationNullifiers: Set<Bytes<32>>;         // prevents duplicate attestations (§9.3)
export ledger pendingHandshakes: Map<Bytes<32>, HandshakeState>; // keyed by nonce (§9.4: single-use)

// Encrypted detail packages, keyed by handshake nonce. Layout (built and
// parsed in the client): [24-byte nonce][NaCl box ciphertext], zero-padded.
// The chain stores them but cannot read them.
export ledger investorPackages: Map<Bytes<32>, Bytes<256>>;  // investor -> business
export ledger businessPackages: Map<Bytes<32>, Bytes<384>>;  // business -> investor

constructor() {
  nextBusinessId = 1;
}

// ============================================================
// Commitment helpers (client-side verification)
// ============================================================
//
// Same persistentCommit the registration circuits use, exposed as pure
// circuits so a receiving browser can recompute a commitment from the
// form + randomness it decrypted and compare it with the on-chain value.

export pure circuit businessCommitmentOf(form: BusinessForm, rand: Bytes<32>): Bytes<32> {
  return persistentCommit<BusinessForm>(form, rand);
}

export pure circuit investorCommitmentOf(form: InvestorForm, rand: Bytes<32>): Bytes<32> {
  return persistentCommit<InvestorForm>(form, rand);
}

// ============================================================
// Investor registration
// ============================================================

export circuit registerInvestor(): Bytes<32> {
  const caller = disclose(callerAddress());
  const form = investorFormData();
  const rand = investorFormRand();

  const investorCommitment = disclose(
    persistentCommit<InvestorForm>(form, rand)
  );

  investors.insert(caller, investorCommitment);
  return caller;
}

// ============================================================
// Business registration — Track A (§4.1)
// ============================================================

export circuit registerBusinessTrackA(
  sector: Bytes<32>,
  location: Bytes<32>
): Uint<64> {
  const id = nextBusinessId;
  const caller = disclose(callerAddress());
  const form = businessFormData();
  const rand = businessFormRand();

  const businessCommitment = disclose(
    persistentCommit<BusinessForm>(form, rand)
  );

  businesses.insert(id, BusinessListing {
    track: Track.TRACK_A,
    tier: 2,                       // baseline tier for formal registration — see §12 open question
    status: Status.OPEN,
    sector: disclose(sector),
    location: disclose(location),
    commitment: businessCommitment,
    listed: true                   // Track A: registration alone is sufficient (§4.1)
  });
  businessOwners.insert(id, caller);
  nextBusinessId = disclose((nextBusinessId + 1) as Uint<64>);
  return id;
}

// ============================================================
// Business registration — Track B (§4.2)
// ============================================================

export circuit registerBusinessTrackB(
  sector: Bytes<32>,
  location: Bytes<32>
): Uint<64> {
  const id = nextBusinessId;
  const caller = disclose(callerAddress());
  const form = businessFormData();
  const rand = businessFormRand();

  const businessCommitment = disclose(
    persistentCommit<BusinessForm>(form, rand)
  );

  businesses.insert(id, BusinessListing {
    track: Track.TRACK_B,
    tier: 0,                       // withheld until attestation threshold reached
    status: Status.OPEN,
    sector: disclose(sector),
    location: disclose(location),
    commitment: businessCommitment,
    listed: false                  // not discoverable until threshold met (§4.2)
  });
  businessOwners.insert(id, caller);
  attestationCounts.insert(id, 0);
  hasUnionAttestation.insert(id, false);
  nextBusinessId = disclose((nextBusinessId + 1) as Uint<64>);
  return id;
}

// ============================================================
// Attestations (§4.2, §9.3, §10.2)
// ============================================================

export circuit submitAttestation(
  businessId: Uint<64>,
  attesterType: AttesterType
): [] {
  const id = disclose(businessId);
  assert(businesses.member(id), "business does not exist");

  const listing = businesses.lookup(id);
  assert(listing.track == Track.TRACK_B, "attestations only apply to Track B businesses");

  const currentCount = attestationCounts.lookup(id);
  assert(currentCount < 4, "maximum of 4 attestations reached");

  const identity = attesterIdentityData();
  // Hash only the secret: one person gets one key whatever type they claim,
  // so they cannot attest twice for a business by switching attesterType.
  const attesterKey = persistentHash<Bytes<32>>(identity.identitySecret);
  // reject duplicate attester/business pairs via nullifier (§9.3)
  const nul = disclose(attestationNullifier(attesterKey, id));
  assert(!attestationNullifiers.member(nul), "attester already attested for this business");
  attestationNullifiers.insert(nul);

  const newCount = disclose((currentCount + 1) as Uint<8>);
  attestationCounts.insert(id, newCount);

  const publicType = disclose(attesterType);
  if (publicType == AttesterType.UNION) {
    hasUnionAttestation.insert(id, true);
  }

  // incremental tier recompute — only when threshold is crossed (§10.2),
  // and only once the required union attestation is present (§9.3, §4.2)
  if (newCount >= 2 && hasUnionAttestation.lookup(id)) {
    businesses.insert(id, BusinessListing {
      track: listing.track,
      tier: tierForCount(newCount),
      status: listing.status,
      sector: listing.sector,
      location: listing.location,
      commitment: listing.commitment,
      listed: true
    });
  }
}

// Placeholder scoring: simple count threshold. Flagged as an open
// question in §12 — may need to become type-weighted rather than
// count-only once the diversity requirement is finalized.
pure circuit tierForCount(count: Uint<8>): Uint<8> {
  if (count >= 4) {
    return 1;   // T1
  } else {
    if (count >= 3) {
      return 2; // T2
    } else {
      return 3; // T3
    }
  }
}

pure circuit attestationNullifier(attesterKey: Bytes<32>, businessId: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "browseme:attestation:v1"), attesterKey, businessId as Field as Bytes<32>]
  );
}

// ============================================================
// Handshake protocol (§7, §8.3, §9.4)
// ============================================================

// investorKey is the investor's encryption public key. The business
// encrypts its details to it once the handshake is sealed.
export circuit initiateHandshake(
  nonce: Bytes<32>,
  businessId: Uint<64>,
  investorKey: Bytes<32>
): [] {
  const n = disclose(nonce);
  const id = disclose(businessId);
  const key = disclose(investorKey);
  const investor = disclose(callerAddress());

  assert(!pendingHandshakes.member(n), "nonce already used");
  assert(businesses.member(id), "business does not exist");
  assert(businesses.lookup(id).listed, "business is not listed");
  assert(investors.member(investor), "caller is not a registered investor");

  pendingHandshakes.insert(n, HandshakeState {
    investorId: investor,       // derived from caller, not passed in — prevents impersonation
    businessId: id,
    shaken: false,
    unshaken: false,
    investorKey: key,
    ownerKey: default<Bytes<32>>
  });
}

// ownerKey is the business owner's encryption public key. The investor
// encrypts their details to it once the handshake is sealed.
export circuit shake(nonce: Bytes<32>, ownerKey: Bytes<32>): [] {
  const n = disclose(nonce);
  const key = disclose(ownerKey);
  assert(pendingHandshakes.member(n), "no such handshake");

  const hs = pendingHandshakes.lookup(n);
  assert(!hs.shaken && !hs.unshaken, "handshake already resolved");

  const caller = disclose(callerAddress());
  assert(businessOwners.lookup(hs.businessId) == caller, "only the business owner can shake");

  pendingHandshakes.insert(n, HandshakeState {
    investorId: hs.investorId,
    businessId: hs.businessId,
    shaken: true,
    unshaken: false,
    investorKey: hs.investorKey,
    ownerKey: key
  });
  // Detail delivery happens through deliverInvestorDetails /
  // deliverBusinessDetails once the handshake is sealed.
}

// ============================================================
// Detail delivery (after a sealed handshake)
// ============================================================

// details = encrypted package built in the client (see ledger comment).
// The contract only checks who is calling and that the handshake is sealed.
export circuit deliverInvestorDetails(nonce: Bytes<32>, details: Bytes<256>): [] {
  const n = disclose(nonce);
  assert(pendingHandshakes.member(n), "no such handshake");

  const hs = pendingHandshakes.lookup(n);
  assert(hs.shaken, "handshake is not sealed");
  assert(!hs.unshaken, "handshake was ended");

  const caller = disclose(callerAddress());
  assert(caller == hs.investorId, "only the investor can deliver investor details");
  assert(!investorPackages.member(n), "investor details already delivered");

  investorPackages.insert(n, disclose(details));
}

export circuit deliverBusinessDetails(nonce: Bytes<32>, details: Bytes<384>): [] {
  const n = disclose(nonce);
  assert(pendingHandshakes.member(n), "no such handshake");

  const hs = pendingHandshakes.lookup(n);
  assert(hs.shaken, "handshake is not sealed");
  assert(!hs.unshaken, "handshake was ended");

  const caller = disclose(callerAddress());
  assert(businessOwners.lookup(hs.businessId) == caller, "only the business owner can deliver business details");
  assert(!businessPackages.member(n), "business details already delivered");

  businessPackages.insert(n, disclose(details));
}

export circuit unshake(nonce: Bytes<32>): [] {
  const n = disclose(nonce);
  assert(pendingHandshakes.member(n), "no such handshake");

  const hs = pendingHandshakes.lookup(n);
  assert(!hs.unshaken, "already unshaken");

  const caller = disclose(callerAddress());
  const isInvestor = caller == hs.investorId;
  const isBusinessOwner = caller == businessOwners.lookup(hs.businessId);
  assert(isInvestor || isBusinessOwner, "only a party to this handshake can unshake");

  pendingHandshakes.insert(n, HandshakeState {
    investorId: hs.investorId,
    businessId: hs.businessId,
    shaken: false,
    unshaken: true,
    investorKey: hs.investorKey,
    ownerKey: hs.ownerKey
  });

  // Callable unilaterally by either party at any point, before or after
  // Shake (§7.1, §9.4/§9.5) — no counterparty cooperation required.
  // Delivered packages are removed from current ledger state. They remain
  // in chain history, so this limits access going forward; it is not erasure.
  if (investorPackages.member(n)) {
    investorPackages.remove(n);
  }
  if (businessPackages.member(n)) {
    businessPackages.remove(n);
  }
}
